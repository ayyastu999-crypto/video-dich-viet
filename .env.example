# Sao chep file nay thanh ".env" roi dien key, HOAC nhap thang tren giao dien
# (bieu tuong banh rang goc tren ben phai) - cach nay de hon.

# Gemini - dung de dich phu de. Lay mien phi: https://aistudio.google.com/apikey
# Ban mien phi gioi han 20 luot goi moi ngay (khoang 4 video).
GEMINI_API_KEY=

# DeepSeek - tuy chon, thay cho Gemini khi can chay nhieu.
# Tra phi nhung rat re (~35d/video), khong gioi han luot.
# Lay tai: https://platform.deepseek.com
DEEPSEEK_API_KEY=
